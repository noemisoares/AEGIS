# ==============================================================================
# AEGIS Backend — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env in backend/ and provide the actual values.
# NEVER commit or expose the real .env file in version control!
# ==============================================================================

NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Connections
# ------------------------------------------------------------------------------
# DATABASE_URL (Application connection):
# For persistent services (Render Node.js backend), prefer Session Pooler (port 5432):
# postgresql://postgres.rnemhexpglipkwvbkyov:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres
#
# If using Transaction Pooler (port 6543, recommended for serverless or high-concurrency):
# Append ?pgbouncer=true so Prisma disables prepared statements:
# postgresql://postgres.rnemhexpglipkwvbkyov:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_URL (Direct / Session connection for migrations):
# Required by Prisma CLI for running migrations (prisma migrate deploy / dev),
# as Transaction pooler does not support migration lock operations:
# postgresql://postgres.rnemhexpglipkwvbkyov:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres
# ------------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
PORT=3001

# ------------------------------------------------------------------------------
# Allowed Origins & Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
FRONTEND_URL=
DESKTOP_AGENT_URL=
ALLOWED_ORIGINS=


