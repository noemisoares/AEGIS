{
  "name": "aegis-backend",
  "version": "1.0.0",
  "description": "AEGIS Platform Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/prepare-db.js && ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "node scripts/prepare-db.js && tsc",
    "start": "node dist/index.js",
    "db:prepare": "node scripts/prepare-db.js",
    "db:generate": "node scripts/prepare-db.js",
    "db:deploy": "node scripts/prepare-db.js && prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node src/seed/index.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "jest --forceExit",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.14.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/pdfkit": "^0.13.3",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "prisma": "^5.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/*.test.ts"
    ]
  }
}
